{
  "name": "client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "preview": "ng build && wrangler dev --env staging",
    "deploy": "node ../scripts/require-branch.mjs main && ng build && wrangler deploy",
    "content:seed": "node ../scripts/content-to-sql.mjs && wrangler d1 execute ondamenu-content --remote --file=d1/seed.sql",
    "content:seed:local": "node ../scripts/content-to-sql.mjs && wrangler d1 execute ondamenu-content --local --file=d1/seed.sql",
    "db:schema": "wrangler d1 execute ondamenu-content --remote --file=d1/schema.sql",
    "db:app-schema": "wrangler d1 execute ondamenu-app --remote --file=d1/app-schema.sql",
    "db:app-schema:staging": "wrangler d1 execute ondamenu-app-staging --remote --file=d1/app-schema.sql",
    "db:schema:local": "wrangler d1 execute ondamenu-content --local --file=d1/schema.sql",
    "deploy:staging": "node ../scripts/require-branch.mjs staging && ng build && wrangler deploy --env staging"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "~21.2.3",
    "@angular/common": "^21.2.5",
    "@angular/compiler": "^21.2.5",
    "@angular/core": "^21.2.5",
    "@angular/forms": "^21.2.5",
    "@angular/material": "~21.2.3",
    "@angular/platform-browser": "^21.2.5",
    "@angular/platform-server": "^21.2.5",
    "@angular/router": "^21.2.5",
    "@angular/ssr": "^21.2.3",
    "rollup": "^4.59.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.3",
    "@angular/cli": "^21.1.3",
    "@angular/compiler-cli": "^21.2.5",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2",
    "wrangler": "^4.160.0"
  }
}
