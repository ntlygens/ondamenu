{
  // OnDaMenu: Angular SSR + content API on Cloudflare Workers, content in D1.
  // Production (main branch):  npm run deploy           -> ondamenu.com
  // Preview (staging branch):  npm run deploy:staging   -> ondamenu-staging.ntlygens.workers.dev
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ondamenu",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client/browser",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ondamenu-content",
      // Created 2026-11-10 (region: eastern North America)
      "database_id": "b5bbc4b6-ee0e-4e64-b729-d963621a7fa3",
      // Local dev (wrangler dev / npm run preview) reads the real Cloudflare database, read-only API.
      "remote": true
    },
    {
      // Accounts, sessions and (later) orders. Production data: never used by preview or local runs.
      "binding": "APP_DB",
      "database_name": "ondamenu-app",
      "database_id": "299b6546-e493-4aeb-841e-98a7872d86cf"
    }
  ],
  // Production also needs a secret, set once with:  npx wrangler secret put AUTH_PEPPER
  // Sign-in emails go out through Cloudflare Email Service (ondamenu.com onboarded 2026-11-10, Workers Paid).
  // Production only: the preview environment has no EMAIL binding, so it shows codes on screen instead.
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    // Cloudflare Turnstile widget "OnDaMenu sign-in" (hostname ondamenu.com). The Site Key is public.
    // The human check switches on once its Secret Key is also set:  npx wrangler secret put TURNSTILE_SECRET
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF-hjSmW1SArd8ED"
    // To create the first administrator in production, add the owner's sign-in address here, for example:
    //   "ADMIN_EMAILS": "name@example.com"
    // (comma-separated for several). That address gets the administrator role when it signs in.
  },
  "routes": [
    { "pattern": "ondamenu.com", "custom_domain": true },
    { "pattern": "www.ondamenu.com", "custom_domain": true }
  ],
  // Deployment id, used to key the page cache so each deploy serves fresh pages.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true },
  "env": {
    // Preview environment for the staging branch: same content database, workers.dev address only.
    "staging": {
      "name": "ondamenu-staging",
      "routes": [],
      "workers_dev": true,
      "d1_databases": [
        { "binding": "DB", "database_name": "ondamenu-content", "database_id": "b5bbc4b6-ee0e-4e64-b729-d963621a7fa3", "remote": true },
        // Test accounts only. Local runs (npm run preview) use this database too.
        { "binding": "APP_DB", "database_name": "ondamenu-app-staging", "database_id": "0b218765-1b47-49fa-9c6b-3612651f4384", "remote": true }
      ],
      "vars": {
        // Preview only: show sign-in codes on screen instead of sending them. Never set in production.
        "DEV_SHOW_CODES": "1",
        // Preview only: this address becomes an administrator when it signs in (test data; codes show on screen).
        "ADMIN_EMAILS": "info@ondamenu.com",
        // Preview only, not a real secret: production uses the AUTH_PEPPER secret.
        "AUTH_PEPPER": "preview-only-not-secret"
      },
      "version_metadata": { "binding": "CF_VERSION_METADATA" }
    }
  }
}
